# ---- Database (Postgres) ----
# Local dev: any Postgres instance (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`)
# or a free hosted one (Neon, Supabase). On Vercel, add a Postgres integration
# (Storage -> Marketplace) and it sets this automatically.
DATABASE_URL=postgres://user:password@localhost:5432/seo_console

# ---- Google OAuth ----
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Also enable "Google Search Console API" under APIs & Services -> Library
# And add your Google account as a Test user on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Session cookie encryption ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---- Sync tuning (optional) ----
SYNC_LOOKBACK_DAYS=40      # window re-pulled on every incremental sync
SYNC_BACKFILL_DAYS=480     # window pulled on a property's very first sync (~16 months, GSC max)
SYNC_DAILY_ROW_LIMIT=2000  # max query/page rows stored per day (history snapshots)
LIVE_MAX_ROWS=50000        # max rows the live dashboard pulls per breakdown (paginated)
INDEX_DAILY_CAP=2000        # URL Inspection calls/day/property (Google's limit; see webmaster-tools/limits)
INDEX_PER_RUN_CAP=500       # max inspections per interactive "Run check" click (nightly sync uses the full day)
INDEX_SUBMIT_DAILY_CAP=190  # Indexing API publish calls/day (Google's default project quota is 200)

# ---- Bing Webmaster Tools (optional, add later) ----
# Bing Webmaster Tools -> Settings -> API access -> API Key
BING_API_KEY=

# ---- Google Indexing API — powers the "Submit to Index" button ----
# By default this uses YOUR Google login (the `.../auth/indexing` scope is
# requested at sign-in). It works when your account is an OWNER of the property.
# Just enable "Web Search Indexing API" in APIs & Services -> Library, then sign
# out and back in once so the new permission is granted. Nothing to set here.
#
# OPTIONAL service-account fallback (only if you can create keys — some orgs block
# it via the iam.disableServiceAccountKeyCreation policy):
# GOOGLE_SA_KEY_FILE=
# GOOGLE_SA_KEY_JSON=
