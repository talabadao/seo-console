# ---- Google OAuth ----
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Also enable "Google Search Console API" under APIs & Services -> Library
# And add your Google account as a Test user on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- Session cookie encryption ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---- Sync tuning (optional) ----
SYNC_LOOKBACK_DAYS=40      # window re-pulled on every incremental sync
SYNC_BACKFILL_DAYS=480     # window pulled on a property's very first sync (~16 months, GSC max)
SYNC_DAILY_ROW_LIMIT=2000  # max query/page rows stored per day (history snapshots)
LIVE_MAX_ROWS=50000        # max rows the live dashboard pulls per breakdown (paginated)
INDEX_DAILY_CAP=200        # max URL Inspection calls/day/property for the index checker

# ---- Bing Webmaster Tools (optional, add later) ----
# Bing Webmaster Tools -> Settings -> API access -> API Key
BING_API_KEY=

# ---- Google Indexing API (optional) — powers the "Submit to Index" button ----
# 1. Cloud Console -> IAM -> Service Accounts -> create one -> add key (JSON) -> download
# 2. APIs & Services -> Library -> enable "Web Search Indexing API"
# 3. Search Console -> Settings -> Users and permissions -> add the service account
#    email (xxxx@xxxx.iam.gserviceaccount.com) as an OWNER of the property
# 4. Point to the downloaded key file (absolute path or relative to the project):
GOOGLE_SA_KEY_FILE=
# ...or paste the whole JSON on one line instead:
# GOOGLE_SA_KEY_JSON=
